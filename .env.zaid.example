# ============================================
# ZAID/ZARA VOICE ASSISTANT CONFIGURATION
# ============================================
# Copy this to .env.local and fill in your keys

# Supabase (already set up from previous steps)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Groq API (FREE tier - needed for LLM responses)
# Get your key: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Optional: Google Embedding API (for vector search - Phase 2)
# GOOGLE_EMBEDDING_API_KEY=...

# Optional: Analytics endpoint (for monitoring)
# ANALYTICS_ENDPOINT=...
