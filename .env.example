# ============================================
# ALAQ - Supabase Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git!

# ----------------------
# SUPABASE CONFIGURATION
# ----------------------

# Get these from: https://app.supabase.com → Settings → API
# Project URL (e.g., https://xyzabc.supabase.co)
SUPABASE_URL="https://your-project-ref.supabase.co"

# Anon Public Key (starts with sb_anon_...)
SUPABASE_PUBLISHABLE_KEY="sb_anon_your-key-here"

# For client-side (Vite replaces these at build time)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_anon_your-key-here"

# ----------------------
# SERVER-SIDE ONLY (keep secret!)
# ----------------------

# Service Role Key (starts with sb_secret_...) - for admin operations
# Only use this in server-side code, never expose to client!
SUPABASE_SERVICE_ROLE_KEY="sb_secret_your-key-here"

# ----------------------
# GOOGLE OAUTH (Optional)
# ----------------------

# Get from: https://console.cloud.google.com/apis/credentials
# GOOGOOGLE_CLIENT_ID="your-google-client-id"
# GOOGOOGLE_CLIENT_SECRET="your-google-client-secret"

# ----------------------
# AI INTEGRATION (Optional - for Zaid/Zara)
# ----------------------

# Option A: OpenAI (recommended)
# OPENAI_API_KEY="sk-your-openai-key"

# Option B: Anthropic
# ANTHROPIC_API_KEY="sk-ant-your-anthropic-key"

# Option C: Keep Lovable AI Gateway
# LOVABLE_API_KEY="your-lovable-api-key"